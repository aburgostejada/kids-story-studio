{
  "name": "kids-story-studio",
  "version": "2.0.0",
  "private": true,
  "description": "Pip and the Missing Glow: a 135-second animated short drawn entirely by code (Canvas 2D), with a guide to building it with AI coding agents.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test tests/",
    "stills": "node film/render.mjs --stills 4,8,15,23,52,68,92,101,113,121,131 --still-dir out/stills",
    "sheet": "node film/render.mjs --stills 0:135:1 --still-dir out/sheet --sheet 6x5",
    "render": "node film/render.mjs --out out/picture.mp4"
  },
  "devDependencies": {
    "playwright": "^1.48.0"
  },
  "engines": { "node": ">=20" }
}
