 "lines": [
  {
   "id": "l01",
   "at": 1.0,
   "text": "Every evening, the garden began to glow."
  },
  {
   "id": "l02",
   "at": 7.2,
   "text": "Water carried the light."
  },
  {
   "id": "l03",
   "at": 14.0,
   "text": "But tonight\u2026"
  },
  {
   "id": "l04",
   "at": 33.8,
   "text": "The channel was dry."
  },
  {
   "id": "l06",
   "at": 51.8,
   "text": "Where had the water stopped?"
  },
  {
   "id": "l07",
   "at": 66.2,
   "text": "One curled leaf was holding back the stream."
  },
  {
   "id": "l08",
   "at": 83.6,
   "text": "Three friends. Three different strengths."
  },
  {
   "id": "l09a",
   "at": 90.2,
   "text": "Bram pushed."
  },
  {
   "id": "l09b",
   "at": 92.4,
   "text": "Luma lifted."
  },
  {
   "id": "l09c",
   "at": 94.8,
   "text": "Pip unrolled."
  },
  {
   "id": "l10",
   "at": 105.2,
   "text": "The water ran, and the light followed."
  },
  {
   "id": "l11",
   "at": 117.6,
   "text": "Some things are easier together."
  },
  {
   "id": "l12",
   "at": 124.4,
   "text": "And the garden was bright enough for everyone."
  }
 ],
